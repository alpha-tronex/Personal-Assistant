# Copy to /opt/whatsapp-bridge/proxy-renew.env on the server (mode 600, root:root).
# Never commit the real file -- see ../.gitignore.

# IPRoyal residential-proxy account credentials (base user/pass, without
# the _country/_state/_session/_lifetime modifiers -- renew-proxy.sh adds
# those itself each run).
IPROYAL_USER=
IPROYAL_PASS=

# Reused from the personal-assistant bot (/opt/assistant/.env on the
# server) so renewal success/failure shows up in the same Telegram chat
# as daily briefs and WA approvals.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
