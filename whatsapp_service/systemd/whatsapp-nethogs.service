# Continuously logs the WhatsApp bridge's network usage so
# bandwidth-report.sh can size the real IPRoyal (per-GB) proxy cost.
# Replaces the original ad-hoc `nethogs ... > /tmp/nethogs-wa.log`, which
# died on the Sep 2026 reboot (and /tmp was wiped), so the report failed.
#
# Only bridge lines are kept, so the log grows ~1 line/min at most.

[Unit]
Description=Log WhatsApp bridge bandwidth via nethogs
After=network-online.target
Wants=network-online.target

[Service]
User=root
ExecStart=/bin/sh -c 'exec /usr/sbin/nethogs -t -d 60 | grep --line-buffered "^node /opt/whatsapp-bridge/index.js/" >> /var/log/nethogs-wa.log'
Restart=always
RestartSec=30

[Install]
WantedBy=multi-user.target
